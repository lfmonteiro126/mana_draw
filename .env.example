DATABASE_URL="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"
NEXT_PUBLIC_STORE_NAME="Mana Draw"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Conta admin: criar via SQL (role='admin'). Nunca promovida no cadastro público.
# Exemplo:
#   insert into users (name, email, password_hash, role)
#   values ('Admin', 'admin@sualoja.com', '<pbkdf2 salt:hash>', 'admin');

# Mercado Pago (Checkout Pro — Pix + cartão)
MERCADOPAGO_ACCESS_TOKEN="APP_USR-..."
MERCADOPAGO_SANDBOX="true"
# Secret do Webhooks em Suas integrações (obrigatório em produção)
MERCADOPAGO_WEBHOOK_SECRET=""

# Melhor Envio (cotação de frete)
MELHOR_ENVIO_TOKEN=""
MELHOR_ENVIO_SANDBOX="true"
MELHOR_ENVIO_FROM_POSTAL_CODE="01310100"
MELHOR_ENVIO_USER_AGENT="Mana Draw (contato@sualoja.com)"
STORE_PICKUP_LABEL="Retirada na loja"

# Vercel Blob (fotos da buylist). No Vercel, crie um Blob Store no projeto.
BLOB_READ_WRITE_TOKEN=""

# E-mail de ofertas da buylist (Resend)
# Crie em https://resend.com — sem isso, o admin precisa enviar o link manualmente.
RESEND_API_KEY=""
EMAIL_FROM="Mana Draw <ofertas@sualoja.com>"

# Opcional: assinar cookies de auth demo (sem DATABASE_URL). Em produção, demo fica off.
# DEMO_AUTH_SECRET=""
# ALLOW_DEMO_AUTH="false"
